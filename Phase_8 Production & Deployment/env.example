# Copy this file to .env and fill in your values

OPENAI_API_KEY=sk-...

# Comma-separated list of valid API keys for the service
VALID_API_KEYS=demo-key-123,another-key-456

# Optional — Langfuse observability (get free keys at cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Used by docker-compose / RAGService
COLLECTION_NAME=production_docs
CHROMA_PERSIST_DIR=./chroma_db

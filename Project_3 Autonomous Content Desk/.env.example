# Project 3: Autonomous Content Desk
# Copy this file to .env and fill in your real keys: cp .env.example .env

OPENAI_API_KEY=sk-...
TAVILY_API_KEY=tvly-...          # free tier at https://tavily.com — used by the crew's research agent

VALID_API_KEYS=demo-key-123      # comma-separated list of keys this service accepts via X-API-Key

# Optional — only needed for /support-compare's fine-tuned side. Point this
# at wherever Phase 7's inference_api.py is being served (e.g. an ngrok URL
# from the Colab session running it). Left blank, /support-compare still
# works — it just skips the fine-tuned side and returns the crew-agent
# response only.
FINETUNED_MODEL_URL=
